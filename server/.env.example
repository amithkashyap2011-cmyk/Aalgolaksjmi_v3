# ═══════════════════════════════════════════════
# AQEA V10.5 ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════

# Core Platform
PORT=9991
MONGO_URI=mongodb://127.0.0.1:27017/aalgolakshmi
JWT_SECRET=YOUR_SECRET_HERE

# Binance Integration
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional fixed-IP egress for API-key requests. Binance keys are IP-whitelisted; on
# a mobile/CGNAT connection the outbound IP changes on every reconnect (-2015). Point
# this at an HTTP proxy with a stable public IP (small VPS running tinyproxy/squid, or
# an SSH-forwarded local port), whitelist THAT IP once, and every request that carries
# the API key goes through it. Public market data and websockets stay direct.
# BINANCE_HTTP_PROXY=http://user:pass@203.0.113.10:8888

# AI & Quant Engine
QUANT_ENGINE_HOST=localhost
QUANT_ENGINE_PORT=8000
PYTHON_QUANT_ENGINE_URL=http://localhost:8000

# Feature Flags
AI_ENABLED=true
CNN_ENABLED=true
PPO_ENABLED=true
TRANSFORMER_SHADOW_MODE=true
MAMBA_ENABLED=true

# Research URLs (Override if running on separate nodes)
CNN_SERVICE_URL=http://localhost:8000/predict/cnn
PPO_SERVICE_URL=http://localhost:8000/predict/ppo-execution
TRANSFORMER_SERVICE_URL=http://localhost:8000/research/predict/transformer-micro
MAMBA_SERVICE_URL=http://localhost:8000/research/predict/mamba

# ── RazorpayX Payouts (real INR → bank/UPI withdrawals) ──
# Required for mode=LIVE on POST /wallet/withdraw/upi. Pays out from your
# FUNDED RazorpayX account balance — it does NOT pull from Binance, so you
# must off-ramp crypto → INR into RazorpayX first.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Optional per-payout hard cap in rupees (0 or unset = no cap). Safety guard.
RAZORPAYX_MAX_INR=0
