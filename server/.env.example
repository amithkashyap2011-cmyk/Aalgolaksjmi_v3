# ═══════════════════════════════════════════════
# AQEA V10.5 ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════

# Core Platform
PORT=9991
MONGO_URI=mongodb://127.0.0.1:27017/aalgolakshmi
JWT_SECRET=YOUR_SECRET_HERE

# Binance Integration
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI & Quant Engine
QUANT_ENGINE_HOST=localhost
QUANT_ENGINE_PORT=8000
PYTHON_QUANT_ENGINE_URL=http://localhost:8000

# Feature Flags
AI_ENABLED=true
CNN_ENABLED=true
PPO_ENABLED=true
TRANSFORMER_SHADOW_MODE=true
MAMBA_ENABLED=true

# Research URLs (Override if running on separate nodes)
CNN_SERVICE_URL=http://localhost:8000/predict/cnn
PPO_SERVICE_URL=http://localhost:8000/predict/ppo-execution
TRANSFORMER_SERVICE_URL=http://localhost:8000/research/predict/transformer-micro
MAMBA_SERVICE_URL=http://localhost:8000/research/predict/mamba
